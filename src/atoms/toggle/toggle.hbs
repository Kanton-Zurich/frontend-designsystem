<label class="atm-toggle {{#if labelLeft}}atm-toggle--label-left{{/if}}" for="{{id}}">
  <input type="checkbox" value="true" name="{{name}}" id="{{id}}"
    {{#if checked}}checked{{/if}}
    {{#if disabled}}disabled{{/if}}
  />
  <span>{{#if labelLeft}}{{{label}}}{{/if}}</span>
  <span class="atm-toggle__switch"></span>
  {{#unless labelLeft}}<span>{{{label}}}</span>{{/unless}}
</label>
