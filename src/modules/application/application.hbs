{{#if heading.title}}
  <h{{heading.level}} class="atm-heading
    {{#if_compare heading.visualLevel "!==" heading.level}}h{{heading.visualLevel}}{{/if_compare}}
    {{#if_compare heading.visualLevel "===" 2 }}atm-heading--bordered{{/if_compare}}"
  >
    {{heading.title}}
  </h{{heading.level}}>
{{/if}}

{{#if description}}
  <p class="mdl-application__description">{{description}}</p>
{{/if}}

{{#if caption}}
  <figure class="mdl-application__figure">
    {{> wrapper-content}}
    <figcaption class="mdl-application__caption">
      {{> "atoms/figcaption/figcaption" caption}}
      {{#if caption.altCaption}}
        <span id="{{caption.altCaptionId}}" class="hidden">{{{altText}}}</span>
      {{/if}}
    </figcaption>
  </figure>
{{else}}
  {{> wrapper-content}}
{{/if}}

{{#if dataDownload}}
  {{>"modules/data_download/data_download" dataDownload }}
{{/if}}

{{#*inline "wrapper-content"}}
  {{#if windowWidth}}
    <div class="mdl-application__wrapper mdl-application__wrapper--window-width
      {{#if heading}}mdl-application__wrapper--with-title{{/if}}
      {{#if caption}}mdl-application__wrapper--with-caption{{/if}}
    " data-anchornav="fullwidth">
      {{> application-content}}
    </div>
  {{else}}
    {{#unless contentWidth}}
      <div class="mdl-application__wrapper
        {{#if heading}}mdl-application__wrapper--with-title{{/if}}
        {{#if caption}}mdl-application__wrapper--with-caption{{/if}}
      " data-anchornav="fullwidth">
        <div class="lyt-wrapper">
          <div class="grid-x grid-margin-x">
            <div class="cell small-12 medium-12 large-12 xlarge-12">
    {{/unless}}
      {{> application-content}}
    {{#unless contentWidth}}
            </div>
          </div>
        </div>
      </div>
    {{/unless}}
  {{/if}}
{{/inline}}

{{#*inline "application-content"}}
  {{#if encapsulated}}
    <zh-application
      src="/modules/application/{{#if mock}}{{mock}}{{else}}canvas{{/if}}.mock.html"
      {{#if caption.altCaptionId}}
        aria-labelledby="{{caption.altCaptionId}}"
      {{else}}
        aria-label="{{altText}}"
      {{/if}}
    >
      <template shadowrootmode="open"></template>
      <div class="mdl-notification hidden">
        <svg class="icon" focusable="false">
          <use xlink:href="#caution"></use>
        </svg>
        <div class="mdl-notification__message">
          <p></p>
        </div>
      </div>
      <div class="atm-loading_circle">
        <span class="atm-loading_circle__spinner"></span>
      </div>
    </zh-application>
  {{else}}
    <div class="mdl-application"
      data-init="application"
      data-snippet-url="/modules/application/{{#if mock}}{{mock}}{{else}}canvas{{/if}}.mock.html"
      {{#if caption.altCaptionId}}
        aria-labelledby="{{caption.altCaptionId}}"
      {{else}}
        aria-label="{{altText}}"
      {{/if}}
    >
      <div class="mdl-notification hidden">
        <svg class="icon" focusable="false">
          <use xlink:href="#caution"></use>
        </svg>
        <div class="mdl-notification__message">
          <p></p>
        </div>
      </div>
      <div class="atm-loading_circle">
        <span class="atm-loading_circle__spinner"></span>
      </div>
    </div>
  {{/if}}
{{/inline}}
