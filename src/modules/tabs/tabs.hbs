<div class="mdl-tabs {{#if isScrollable}}mdl-tabs--scrollable{{/if}}" data-init="tabs">

  {{#if isScrollable}}
    <div class="lyt-wrapper">
      <div class="grid-x grid-margin-x">
        <div class="cell small-offset-2 medium-offset-2 large-offset-2 small-10 xlarge-12">
          {{> tabs}}
        </div>
        <div class="cell small-offset-2 medium-offset-2 large-offset-2 xlarge-offset-2 small-10 medium-9 large-8">
          {{> panels}}
        </div>
      </div>
    </div>
  {{else}}
    {{> tabs}}
    {{> panels}}
  {{/if}}

  {{#*inline "tabs"}}
    <div class="mdl-tabs__controls">
      <div class="mdl-tabs__controls-wrapper">
        <ul class="mdl-button_group" data-init="buttonGroup">
          {{#each tabs}}
          <li class="mdl-button_group__item">
            <button
              class="atm-button atm-button--secondary"
              data-tab-index="{{@index}}"
              role="tab"
              aria-selected="false"
              {{#if id}}id="{{id}}" aria-controls="{{id}}-panel"{{/if}}
            >
              {{{title}}}
            </button>
          </li>
          {{/each}}
        </ul>
      </div>
    </div>
  {{/inline}}

  {{#*inline "panels"}}
    {{#each tabs}}
      <div
        class="mdl-tabs__tab"
        role="tabpanel"
        {{#if id}}id="{{id}}-panel" aria-describedby="{{id}}"{{/if}}
      >{{{data}}}</div>
    {{/each}}
  {{/inline}}
</div>
