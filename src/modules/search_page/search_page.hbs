<div class="mdl-search_page mod-smaller-headings" data-init="searchPage"
  {{#if options}}data-search-page-options="{{options}}"{{/if}}
>
  <form novalidate class="mdl-search_page__form" data-search_page="form">
    {{> "modules/search/search" input}}
  </form>
  {{> "modules/extended_search/extended_search" extendedSearch}}
  <div class="mdl-search_page__validation">
    {{> "modules/notification/notification" validationData }}
  </div>
  <div class="mdl-search_page__notification">
    {{> "modules/notification/notification" notificationData }}
  </div>
  {{> "modules/most_searched/most_searched" this}}

  <div class="mdl-search_page__results-wrapper" data-search_page="wrapper" aria-live="polite">

    <div class="mdl-search_page__results-head" data-search_page="resultsHead">
      <div class="mdl-search_page__autocorrection">
        <p>Ergebnisse für: <a class="atm-text_link mdl-search_page__autocorrected" role="button" data-search_page="force"></a></p>
        <p>Stattdessen suchen nach <a class="atm-text_link mdl-search_page__original" role="button" data-search_page="force"></a></p>
      </div>
      <p class="mdl-search_page__suggestions">Meinten Sie: <span></span></p>
      <template data-search_page="didYouMeanTemplate">
        <a class="atm-text_link" role="button" data-search_page="force"></a>
      </template>
    </div>

    <div class="mdl-search_page__results" data-search_page="results">
      <h2 class="visuallyhidden">Gefundene Resultate</h2>
      {{> "modules/tabs/tabs" tabs }}
    </div>

    {{> "atoms/loading_circle/loading_circle"}}
    <div class="mdl-search_page__no-results mdl-placeholder">
      <h3 class="atm-heading mdl-placeholder__title">{{{noResultsPlaceholder.title}}}</h3>
      <p class="atm-paragraph mdl-placeholder__text">{{noResultsPlaceholder.text}}</p>
      {{>"atoms/button/button" noResultsPlaceholder.button }}
    </div>
  </div>
</div>
